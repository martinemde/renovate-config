{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>martinemde/renovate-config#v1.0.0"
  ],
  "enabledManagers": [
    "github-actions",
    "renovate-config"
  ],
  "automerge": false,
  "vulnerabilityAlerts": {"automerge": true},
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "digest", "major"],
      "automerge": true
    },
    {
      "matchJsonata": ["isVulnerabilityAlert = true"],
      "automerge": true
    },
    {
      "matchManagers": ["renovate-config"],
      "automerge": false
    }
  ]
}
